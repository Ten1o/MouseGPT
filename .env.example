# MouseGPT model-service configuration template (contract for the staged setup).
# Copy to .env.local at the repository root. Do not commit .env.local.
# External Stage 2/3/4 model requests read this file through the shared loader.
# The optional local SWIFT server uses MOUSEGPT_SERVING_API_KEY separately.
# MOUSEGPT_SERVING_API_KEY=
#
# Provider: openai | azure_openai | anthropic | gemini | groq | deepseek |
# mistral | openrouter | xai | siliconflow | openai_compatible
# Built-in providers select their base URL automatically. Set an endpoint
# only for Azure or openai_compatible; it must be a service base URL.
# The default provider is the official OpenAI API.
MOUSEGPT_PROVIDER=openai
# MOUSEGPT_ENDPOINT=https://api.openai.com/v1
MOUSEGPT_API_KEY=

# Defaults follow the model IDs used by the existing stage scripts.
# Names become deployment names if a role uses Azure OpenAI.
# Stage 1 does not use a language-model API.
MOUSEGPT_VISION_MODEL=gpt-4o-2024-05-13
MOUSEGPT_EMBEDDING_MODEL=text-embedding-3-large
MOUSEGPT_ANALYSIS_MODEL=gpt-4o
MOUSEGPT_AGENT_MODEL=gpt-4o

# Azure API versions are only needed for roles using Azure OpenAI.
# MOUSEGPT_VISION_API_VERSION=2024-12-01-preview
# MOUSEGPT_EMBEDDING_API_VERSION=2023-05-15
# MOUSEGPT_ANALYSIS_API_VERSION=2024-12-01-preview
# MOUSEGPT_AGENT_API_VERSION=2024-12-01-preview

# Optional overrides let one role use a different provider/account/endpoint.
# Set only the fields that differ from the shared values above.
# MOUSEGPT_VISION_PROVIDER=azure_openai
# MOUSEGPT_VISION_ENDPOINT=https://RESOURCE.openai.azure.com/
# MOUSEGPT_VISION_API_KEY=
# MOUSEGPT_VISION_MODEL=YOUR_VISION_DEPLOYMENT
# MOUSEGPT_EMBEDDING_PROVIDER=azure_openai
# MOUSEGPT_EMBEDDING_ENDPOINT=https://OTHER_RESOURCE.openai.azure.com/
# MOUSEGPT_EMBEDDING_API_KEY=
# MOUSEGPT_EMBEDDING_MODEL=YOUR_EMBEDDING_DEPLOYMENT
# MOUSEGPT_ANALYSIS_PROVIDER=openai_compatible
# MOUSEGPT_ANALYSIS_ENDPOINT=https://provider.example/v1
# MOUSEGPT_ANALYSIS_API_KEY=
# MOUSEGPT_ANALYSIS_MODEL=PROVIDER_CHAT_MODEL
# MOUSEGPT_AGENT_PROVIDER=azure_openai
# MOUSEGPT_AGENT_ENDPOINT=https://OTHER_RESOURCE.openai.azure.com/
# MOUSEGPT_AGENT_API_KEY=
# MOUSEGPT_AGENT_MODEL=YOUR_AGENT_DEPLOYMENT

# Stage 3 phenotype prediction is a separate, optional Responses API workflow.
# Its provider must support Responses with Code Interpreter; it cannot be
# assumed to work merely because chat completions work.
# MOUSEGPT_PHENOTYPE_PROVIDER=openai
# MOUSEGPT_PHENOTYPE_ENDPOINT=https://api.openai.com/v1
# MOUSEGPT_PHENOTYPE_API_KEY=
# MOUSEGPT_PHENOTYPE_MODEL=gpt-4o
# MOUSEGPT_PHENOTYPE_API_VERSION=
